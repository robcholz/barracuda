{
  "type": "function",
  "function": {
    "name": "subagent_run",
    "description": "Run a subagent synchronously and block the current agent until its result arrives. Do not use this by default; prefer subagent_spawn unless the current step explicitly requires the result before continuing.",
    "parameters": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "trimmedNonEmpty": true,
          "description": "Agent kind from subagent_list_spawnable."
        },
        "name": {
          "type": "string",
          "trimmedNonEmpty": true,
          "description": "Short label for the subagent."
        },
        "goal": {
          "type": "string",
          "trimmedNonEmpty": true,
          "description": "Standalone task for the subagent."
        },
        "timeout_ms": {
          "type": "integer",
          "description": "Maximum lifetime in milliseconds."
        }
      },
      "required": ["kind", "name", "goal", "timeout_ms"]
    }
  }
}
