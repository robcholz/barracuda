# Copy this file to `.env.local` and fill in values for `barracuda`.
#
#   cp .env.example .env.local
#
# Unit tests do not need these values. The CLI fails clearly when a required
# value is missing.

BARRACUDA_LLM_API_KEY=
BARRACUDA_LLM_BASE_URL=https://api.openai.com
BARRACUDA_LLM_MODEL=gpt-4o-mini
