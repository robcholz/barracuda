# Copy this file to `.env.local` and fill in values for `barracuda`.
#
#   cp .env.example .env.local
#
# Unit tests do not need these values. The model API configuration helper fails
# clearly when a required value is missing.

# macOS: use the forwarded URL printed when Barracuda starts, without a trailing
# slash. Linux: use http://10.42.0.2:8787.
BARRACUDA_ADDRESS=

BARRACUDA_LLM_API_KEY=
BARRACUDA_LLM_BASE_URL=https://api.openai.com
BARRACUDA_LLM_MODEL=gpt-4o-mini
