#!/bin/sh
# Links ESP32-P4 firmware with GNU ld from the Espressif toolchain.
#
# rustc passes lld-style arguments for riscv32imafc-unknown-none-elf. C
# libraries built for the board, such as mbedtls, also need newlib and libgcc
# from the hard-float (ilp32f) multilib, which rust-lld would not find.
set -eu
here=$(cd "$(dirname "$0")" && pwd)

if [ "${1:-}" = "-flavor" ]; then
    shift 2
fi

abi="-march=rv32imafc -mabi=ilp32f"
gcc="$here/riscv32-esp-elf-gcc"
# shellcheck disable=SC2086 # abi holds two flags.
libc=$("$gcc" $abi -print-file-name=libc.a)
# shellcheck disable=SC2086
libm=$("$gcc" $abi -print-file-name=libm.a)
# shellcheck disable=SC2086
libgcc=$("$gcc" $abi -print-libgcc-file-name)

exec "$here/esp32p4-tool" ld "$@" --start-group "$libc" "$libm" "$libgcc" --end-group
