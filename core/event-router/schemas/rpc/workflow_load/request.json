{
  "type": "object",
  "properties": {
    "id": { "type": "string" },
    "match": {
      "type": "object",
      "properties": {
        "event": { "type": "string" },
        "topic": { "type": "string" }
      },
      "required": ["event"],
      "additionalProperties": false
    },
    "steps": {
      "type": "array",
      "items": {
        "oneOf": [
          { "$ref": "#/$defs/call" },
          { "$ref": "#/$defs/return" },
          { "$ref": "#/$defs/branch" }
        ]
      },
      "minItems": 1
    }
  },
  "required": ["id", "match", "steps"],
  "additionalProperties": false,
  "$defs": {
    "call": {
      "type": "object",
      "properties": {
        "call": { "type": "string" },
        "arguments": { "type": "object" }
      },
      "required": ["call"],
      "additionalProperties": false
    },
    "return": {
      "type": "object",
      "properties": {
        "return": {
          "type": "object",
          "properties": {},
          "additionalProperties": false
        }
      },
      "required": ["return"],
      "additionalProperties": false
    },
    "branch_arm": {
      "type": "array",
      "items": {
        "oneOf": [
          { "$ref": "#/$defs/call" },
          { "$ref": "#/$defs/return" },
          { "$ref": "#/$defs/branch" }
        ]
      }
    },
    "branch": {
      "type": "object",
      "properties": {
        "if": {
          "type": "object",
          "properties": {
            "source": { "type": "string" },
            "equals": {}
          },
          "required": ["source", "equals"],
          "additionalProperties": false
        },
        "then": { "$ref": "#/$defs/branch_arm" },
        "else": { "$ref": "#/$defs/branch_arm" }
      },
      "required": ["if", "then", "else"],
      "additionalProperties": false
    }
  }
}
