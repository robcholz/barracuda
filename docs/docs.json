{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "sequoia",
  "name": "Barracuda",
  "description": "The agentic platform for embedded devices: everything is a Plugin, and an agent helps at every step.",
  "colors": {
    "primary": "#5A7301",
    "light": "#CCFF00",
    "dark": "#CCFF00"
  },
  "background": {
    "color": {
      "light": "#FAFAFB",
      "dark": "#09090B"
    }
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "favicon": "/favicon.svg",
  "appearance": {
    "default": "system"
  },
  "icons": {
    "library": "lucide"
  },
  "styling": {
    "eyebrows": "section",
    "codeblocks": {
      "theme": {
        "light": "github-light",
        "dark": "github-dark"
      }
    }
  },
  "navbar": {
