{
  "name": "barracuda-web-tooling",
  "private": true,
  "type": "module",
  "scripts": {
    "format": "bun --bun run prettier --write 'plugins/*/resources/web/**/*.{ts,css,html}' 'design-system/**/*.{ts,css}' 'tools/web/**/*.ts' 'apps/live-editor/web/**/*.ts' package.json tsconfig.json eslint.config.mjs",
    "format:check": "bun --bun run prettier --check 'plugins/*/resources/web/**/*.{ts,css,html}' 'design-system/**/*.{ts,css}' 'tools/web/**/*.ts' 'apps/live-editor/web/**/*.ts' package.json tsconfig.json eslint.config.mjs",
    "lint": "bun --bun run eslint 'plugins/*/resources/web/**/*.ts' 'design-system/**/*.ts' 'tools/web/**/*.ts' 'apps/live-editor/web/**/*.ts'",
    "check": "bun --bun run tsc --noEmit",
    "test": "bun test ./plugins ./design-system ./tools/web ./apps/live-editor/web",
    "dev": "bun plugins/captive-portal/resources/web/build.ts && bun plugins/captive-portal/resources/web/preview.ts"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/legacy-modes": "^6.5.5",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/merge": "^6.12.2",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@lezer/highlight": "^1.2.5",
    "@types/bun": "^1.4.1",
    "codemirror": "^6.0.2",
    "eslint": "^10.10.0",
    "happy-dom": "^20.14.0",
    "prettier": "^3.9.6",
    "typescript": "^6",
    "typescript-eslint": "^8.69.0",
    "wasmoon": "1.16.0"
  }
}
