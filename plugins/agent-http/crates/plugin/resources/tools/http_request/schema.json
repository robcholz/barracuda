{
  "type": "function",
  "function": {
    "name": "http_request",
    "description": "Perform one outbound HTTP or HTTPS request and return its UTF-8 response.",
    "parameters": {
      "type": "object",
      "properties": {
        "method": { "enum": ["GET", "POST", "PUT", "PATCH", "DELETE", "HEAD"] },
        "url": { "type": "string", "trimmedNonEmpty": true, "maxLength": 2048 },
        "headers": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "object",
            "properties": {
              "name": { "type": "string", "trimmedNonEmpty": true },
              "value": { "type": "string" }
            },
            "required": ["name", "value"],
            "additionalProperties": false
          }
        },
        "body": { "type": "string", "maxLength": 32768 }
      },
      "required": ["method", "url"],
      "additionalProperties": false
    }
  }
}
