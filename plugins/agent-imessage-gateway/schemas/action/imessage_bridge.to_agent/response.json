{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "open_required": { "type": "boolean" },
        "session": { "type": "string", "pattern": "^session-[0-9]+$" }
      },
      "required": ["open_required", "session"],
      "additionalProperties": false
    },
    {
      "type": "object",
      "maxProperties": 0,
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "session": { "type": "string", "pattern": "^session-[0-9]+$" },
        "input_request": { "type": "string", "pattern": "^input-[0-9]+$" }
      },
      "required": ["session"],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "error": { "enum": ["invalid_request", "conflict", "storage"] }
      },
      "required": ["error"],
      "additionalProperties": false
    }
  ]
}
