{
  "type": "function",
  "function": {
    "name": "workflow_load",
    "description": "Validate, persist, and load one complete Workflow DSL definition.",
    "parameters": {
      "type": "object",
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+$" },
        "match": {
          "type": "object",
          "properties": {
            "event": { "type": "string", "trimmedNonEmpty": true },
            "topic": { "type": "string", "trimmedNonEmpty": true }
          },
          "required": ["event"],
          "additionalProperties": false
        },
        "steps": {
          "type": "array",
          "items": {
            "oneOf": [
              { "$ref": "#/$defs/call" },
              { "$ref": "#/$defs/return" },
              { "$ref": "#/$defs/branch" }
            ]
          },
          "minItems": 1
        }
      },
      "required": ["id", "match", "steps"],
      "additionalProperties": false,
      "$defs": {
        "call": {
          "type": "object",
          "properties": {
            "call": { "type": "string", "trimmedNonEmpty": true },
            "arguments": { "type": "object" }
          },
          "required": ["call"],
          "additionalProperties": false
        },
        "return": {
          "type": "object",
          "properties": {
            "return": {
              "type": "object",
              "properties": {},
              "additionalProperties": false
            }
          },
          "required": ["return"],
          "additionalProperties": false
        },
        "branch_arm": {
          "type": "array",
          "items": {
            "oneOf": [
              { "$ref": "#/$defs/call" },
              { "$ref": "#/$defs/return" },
              { "$ref": "#/$defs/branch" }
            ]
          }
        },
        "branch": {
          "type": "object",
          "properties": {
            "if": {
              "oneOf": [
                {
                  "type": "object",
                  "properties": {
                    "source": { "type": "string", "trimmedNonEmpty": true },
                    "equals": {}
                  },
                  "required": ["source", "equals"],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "source": { "type": "string", "trimmedNonEmpty": true },
                    "not_equals": {}
                  },
                  "required": ["source", "not_equals"],
                  "additionalProperties": false
                }
              ]
            },
            "then": { "$ref": "#/$defs/branch_arm" },
            "else": { "$ref": "#/$defs/branch_arm" }
          },
          "required": ["if", "then", "else"],
          "additionalProperties": false
        }
      }
    }
  }
}
