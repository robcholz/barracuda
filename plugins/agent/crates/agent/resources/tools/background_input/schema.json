              "maximum": 4294967295
            },
            "input": { "type": "string" }
          },
          "required": ["id", "input"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "integer",
              "minimum": 1,
              "maximum": 4294967295
            },
            "eof": { "const": true }
          },
          "required": ["id", "eof"],
          "additionalProperties": false
        }
      ]
    }
  }
}
