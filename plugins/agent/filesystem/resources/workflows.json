[
  {
    "id": "imessage-to-agent",
    "match": {
      "event": "gateway.message.received"
    },
    "steps": [
      {
        "call": "imessage_bridge.to_agent"
      },
      {
        "if": {
          "source": "$previous.output",
          "equals": {}
        },
        "then": [
          {
            "call": "session.new",
            "arguments": {
              "persistence": "persistent"
            }
          },
          {
            "call": "session.open",
            "arguments": {
              "session": "$previous.output.session"
            }
          },
          {
            "call": "imessage_bridge.to_agent",
            "arguments": {
              "route": "$event.input.route",
              "message_id": "$event.input.message_id",
              "session": "$previous.output.session"
            }
          },
          {
            "call": "session.append",
            "arguments": {
              "session": "$previous.output.session",
              "text": "$event.input.text"
            }
          },
          {
            "return": {}
          }
        ],
        "else": [
          {
            "if": {
              "source": "$previous.output.open_required",
              "equals": true
            },
            "then": [
              {
                "call": "session.open",
                "arguments": {
                  "session": "$previous.output.session"
                }
              },
              {
                "if": {
                  "source": "$previous.output.error",
                  "not_equals": null
                },
                "then": [
                  {
                    "call": "gateway.send_stream",
                    "arguments": {
                      "route": "$event.input.route",
                      "reply_to": "$event.input.message_id",
                      "session": "$previous.output.session",
                      "sequence": 0,
                      "type": "stream_error",
                      "payload": "$previous.output"
                    }
                  },
                  {
                    "return": {}
                  }
                ],
                "else": []
              }
            ],
            "else": []
          },
          {
            "call": "imessage_bridge.to_agent",
            "arguments": {
              "route": "$event.input.route",
              "message_id": "$event.input.message_id",
              "session": "$previous.output.session"
            }
          },
          {
            "if": {
              "source": "$previous.output.input_request",
              "not_equals": null
            },
            "then": [
              {
                "call": "session.respond",
                "arguments": {
                  "session": "$previous.output.session",
                  "request": "$previous.output.input_request",
                  "text": "$event.input.text"
                }
              }
            ],
            "else": [
              {
                "call": "session.append",
                "arguments": {
                  "session": "$previous.output.session",
                  "text": "$event.input.text"
                }
              }
            ]
          },
          {
            "return": {}
          }
        ]
      }
    ]
  },
  {
    "id": "imessage-control-to-agent",
    "match": {
      "event": "gateway.control.received"
    },
    "steps": [
      {
        "call": "imessage_bridge.to_agent",
        "arguments": {
          "route": "$event.input.route"
        }
      },
      {
        "if": {
          "source": "$previous.output.open_required",
          "equals": false
        },
        "then": [
          {
            "if": {
              "source": "$event.input.control",
              "equals": "interrupt"
            },
            "then": [
              {
                "call": "session.interrupt",
                "arguments": {
                  "session": "$previous.output.session"
                }
              }
            ],
            "else": [
              {
                "call": "session.cancel",
                "arguments": {
                  "session": "$previous.output.session"
                }
              }
            ]
          }
        ],
        "else": []
      },
      {
        "return": {}
      }
    ]
  },
  {
    "id": "agent-to-imessage",
    "match": {
      "event": "session.event"
    },
    "steps": [
      {
        "call": "imessage_bridge.to_gateway"
      },
      {
        "if": {
          "source": "$previous.output",
          "equals": {}
        },
        "then": [
          {
            "return": {}
          }
        ],
        "else": [
          {
            "call": "gateway.send_stream",
            "arguments": {
              "route": "$previous.output.route",
              "reply_to": "$previous.output.reply_to",
              "session": "$event.input.session",
              "sequence": "$event.input.sequence",
              "type": "$event.input.type",
              "payload": "$event.input.payload"
            }
          },
          {
            "return": {}
          }
        ]
      }
    ]
  }
]
