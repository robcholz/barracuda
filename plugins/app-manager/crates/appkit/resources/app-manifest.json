{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "file": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9_.-]+$"
    },
    "package": {
      "type": "string",
      "minLength": 1,
      "maxLength": 32,
      "pattern": "^[A-Za-z0-9_.-]+$"
    },
    "packages": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "$ref": "#/$defs/package"
      }
    },
    "requirement": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40
    },
    "requirements": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "$ref": "#/$defs/requirement"
      }
    }
  },
  "type": "object",
  "properties": {
    "format": {
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 32,
      "pattern": "^[A-Za-z0-9_.-]+$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 32
    },
    "entry": {
      "$ref": "#/$defs/file"
    },
    "view": {
      "type": "object",
      "properties": {
        "program": {
          "$ref": "#/$defs/file"
        },
        "styles": {
          "$ref": "#/$defs/file"
        },
        "fonts": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "$ref": "#/$defs/file"
          }
        },
        "size": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4096
          }
        }
      },
      "required": [
        "program",
        "styles"
      ],
      "additionalProperties": false
    },
    "icon": {
      "type": "string",
      "minLength": 1,
      "maxLength": 32,
      "pattern": "^[A-Za-z0-9_.-]+$"
    },
    "api": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000
    },
    "requires": {
      "$ref": "#/$defs/requirements"
    },
    "uses": {
      "$ref": "#/$defs/requirements"
    },
    "permissions": {
      "$ref": "#/$defs/packages"
    },
    "boards": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 64,
        "pattern": "^[A-Za-z0-9_.-]+$"
      }
    }
  },
  "required": [
    "format",
    "id",
    "name",
    "version"
  ],
  "additionalProperties": false
}
