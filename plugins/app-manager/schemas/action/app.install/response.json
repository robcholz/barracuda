{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "app": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        },
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "location": {
          "enum": [
            "builtin",
            "installed",
            "workspace"
          ]
        },
        "kind": {
          "enum": [
            "system",
            "installable"
          ]
        },
        "has_view": {
          "type": "boolean"
        },
        "api": {
          "type": "integer",
          "minimum": 1
        },
        "requires": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "uses": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "permissions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "boards": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "view_size": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1
          },
          "minItems": 2,
          "maxItems": 2
        },
        "view_shape": {
          "enum": [
            "round",
            "rect"
          ]
        },
        "icon": {
          "type": "string"
        },
        "incompatible": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "name",
        "version",
        "location",
        "kind",
        "has_view",
        "api",
        "requires",
        "uses",
        "permissions",
        "boards"
      ],
      "additionalProperties": false
    }
  },
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "requested": {
          "$ref": "#/$defs/app"
        }
      },
      "required": [
        "requested"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "error": {
          "enum": [
            "not_found",
            "system_app",
            "invalid_bundle",
            "storage",
            "incompatible"
          ]
        },
        "reason": {
          "type": "string"
        }
      },
      "required": [
        "error"
      ],
      "additionalProperties": false
    }
  ]
}
