{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "app": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        },
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "location": {
          "enum": [
            "bundled",
            "installed",
            "workspace"
          ]
        },
        "has_view": {
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "name",
        "version",
        "location",
        "has_view"
      ],
      "additionalProperties": false
    }
  },
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "app": {
          "$ref": "#/$defs/app"
        },
        "run_id": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        }
      },
      "required": [
        "app",
        "run_id"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "error": {
          "enum": [
            "not_found",
            "invalid_bundle",
            "storage",
            "view_rejected",
            "runtime_unavailable",
            "busy"
          ]
        }
      },
      "required": [
        "error"
      ],
      "additionalProperties": false
    }
  ]
}
