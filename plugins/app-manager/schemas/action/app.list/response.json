{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "app": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        },
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "location": {
          "enum": [
            "builtin",
            "workspace"
          ]
        },
        "kind": {
          "enum": [
            "system",
            "installable"
          ]
        },
        "has_view": {
          "type": "boolean"
        },
        "api": {
          "type": "integer",
          "minimum": 1
        },
        "requires": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "uses": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "permissions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "boards": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "view_size": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1
          },
          "minItems": 2,
          "maxItems": 2
        },
        "view_target": {
          "type": "object",
          "properties": {
            "size": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 1
              },
              "minItems": 2,
              "maxItems": 2
            },
            "density": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": [
            "size",
            "density"
          ],
          "additionalProperties": false
        },
        "icon": {
          "type": "string"
        },
        "incompatible": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "name",
        "version",
        "location",
        "kind",
        "has_view",
        "api",
        "requires",
        "uses",
        "permissions",
        "boards"
      ],
      "additionalProperties": false
    },
    "invalid": {
      "type": "object",
      "properties": {
        "location": {
          "enum": [
            "builtin",
            "workspace"
          ]
        },
        "dir": {
          "type": "string"
        },
        "problem": {
          "type": "string"
        }
      },
      "required": [
        "location",
        "dir",
        "problem"
      ],
      "additionalProperties": false
    }
  },
  "type": "object",
  "properties": {
    "apps": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/app"
      }
    },
    "invalid": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/invalid"
      }
    }
  },
  "required": [
    "apps",
    "invalid"
  ],
  "additionalProperties": false
}
