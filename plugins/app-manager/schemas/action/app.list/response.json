{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "app": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        },
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "location": {
          "enum": [
            "bundled",
            "installed"
          ]
        },
        "has_view": {
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "name",
        "version",
        "location",
        "has_view"
      ],
      "additionalProperties": false
    }
  },
  "type": "object",
  "properties": {
    "apps": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/app"
      }
    }
  },
  "required": [
    "apps"
  ],
  "additionalProperties": false
}
