{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "app": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        },
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "location": {
          "enum": [
            "builtin",
            "workspace"
          ]
        },
        "kind": {
          "enum": [
            "system",
            "installable"
          ]
        },
        "has_view": {
          "type": "boolean"
        },
        "api": {
          "type": "integer",
          "minimum": 1
        },
        "requires": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "uses": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "permissions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "boards": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "view_size": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1
          },
          "minItems": 2,
          "maxItems": 2
        },
        "icon": {
          "type": "string"
        },
        "incompatible": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "name",
        "version",
        "location",
        "kind",
        "has_view",
        "api",
        "requires",
        "uses",
        "permissions",
        "boards"
      ],
      "additionalProperties": false
    },
    "running": {
      "type": "object",
      "properties": {
        "app": {
          "$ref": "#/$defs/app"
        },
        "run_id": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        },
        "state": {
          "enum": [
            "active",
            "inactive",
            "background",
            "suspended",
            "running",
            "terminating"
          ]
        }
      },
      "required": [
        "app",
        "run_id",
        "state"
      ],
      "additionalProperties": false
    },
    "exit": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "run_id": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        },
        "outcome": {
          "enum": [
            "success",
            "cancelled",
            "error"
          ]
        },
        "error": {
          "enum": [
            "vm_create",
            "vm_configure",
            "lua_load",
            "lua_runtime",
            "unexpected_yield",
            "lua_memory"
          ]
        },
        "diagnostic": {
          "type": "string"
        },
        "output": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "type": "string"
          }
        },
        "foreground": {
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "run_id",
        "outcome",
        "output",
        "foreground"
      ],
      "additionalProperties": false
    }
  },
  "type": "object",
  "properties": {
    "foreground": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/running"
        }
      ]
    },
    "running": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "$ref": "#/$defs/running"
      }
    },
    "texts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "last_exit": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/exit"
        }
      ]
    }
  },
  "required": [
    "foreground",
    "running",
    "last_exit"
  ],
  "additionalProperties": false
}
