{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "app": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        },
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "location": {
          "enum": [
            "bundled",
            "installed"
          ]
        },
        "has_view": {
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "name",
        "version",
        "location",
        "has_view"
      ],
      "additionalProperties": false
    },
    "foreground": {
      "type": "object",
      "properties": {
        "app": {
          "$ref": "#/$defs/app"
        },
        "run_id": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        }
      },
      "required": [
        "app",
        "run_id"
      ],
      "additionalProperties": false
    },
    "exit": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "run_id": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        },
        "outcome": {
          "enum": [
            "success",
            "cancelled",
            "error"
          ]
        },
        "error": {
          "enum": [
            "vm_create",
            "vm_configure",
            "lua_load",
            "lua_runtime",
            "unexpected_yield",
            "lua_memory"
          ]
        },
        "diagnostic": {
          "type": "string"
        },
        "output": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "id",
        "run_id",
        "outcome",
        "output"
      ],
      "additionalProperties": false
    }
  },
  "type": "object",
  "properties": {
    "foreground": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/foreground"
        }
      ]
    },
    "texts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "last_exit": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/exit"
        }
      ]
    }
  },
  "required": [
    "foreground",
    "last_exit"
  ],
  "additionalProperties": false
}
