{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object",
      "maxProperties": 0,
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "error": {
          "enum": [
            "invalid_request",
            "not_found",
            "permission_denied",
            "too_large",
            "io"
          ]
        }
      },
      "required": ["error"],
      "additionalProperties": false
    }
  ]
}
