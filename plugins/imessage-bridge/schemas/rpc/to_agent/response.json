{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "found": { "const": true },
        "open_required": { "type": "boolean" },
        "session": { "type": "string", "pattern": "^session-[0-9]+$" }
      },
      "required": ["found", "open_required", "session"],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "found": { "const": false },
        "open_required": { "const": false }
      },
      "required": ["found", "open_required"],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "session": { "type": "string", "pattern": "^session-[0-9]+$" }
      },
      "required": ["session"],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "error": { "enum": ["invalid_request", "conflict", "storage"] }
      },
      "required": ["error"],
      "additionalProperties": false
    }
  ]
}
