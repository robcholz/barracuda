{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object",
      "properties": { "forward": { "const": false } },
      "required": ["forward"],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "forward": { "const": true },
        "command_id": { "type": "string", "pattern": "^command-[0-9]+$" }
      },
      "required": ["forward", "command_id"],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "action": { "const": "start" },
        "stream_id": { "type": "string" },
        "sequence": { "const": 0 },
        "channel": { "type": "string" },
        "conversation_id": { "type": "string" },
        "thread_id": { "type": "string" },
        "reply_to": { "type": "string" }
      },
      "required": ["action", "stream_id", "sequence", "channel", "conversation_id", "reply_to"],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "action": { "const": "chunk" },
        "stream_id": { "type": "string" },
        "sequence": { "type": "integer", "minimum": 1 },
        "field": { "const": "text" },
        "boundary": { "enum": ["more", "complete"] },
        "text": { "type": "string" }
      },
      "required": ["action", "stream_id", "sequence", "field", "boundary", "text"],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "action": { "const": "finish" },
        "stream_id": { "type": "string" },
        "sequence": { "type": "integer", "minimum": 1 }
      },
      "required": ["action", "stream_id", "sequence"],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "error": { "enum": ["invalid_request", "busy", "unknown_command"] }
      },
      "required": ["error"],
      "additionalProperties": false
    }
  ]
}
