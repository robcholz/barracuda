{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "forward": { "const": false }
      },
      "required": ["forward"],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "forward": { "const": true },
        "route": { "$ref": "#/$defs/route" },
        "reply_to": { "type": "string", "minLength": 1 }
      },
      "required": ["forward", "route", "reply_to"],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "error": { "const": "invalid_request" }
      },
      "required": ["error"],
      "additionalProperties": false
    }
  ],
  "$defs": {
    "route": {
      "type": "object",
      "properties": {
        "channel": { "type": "string", "minLength": 1 },
        "conversation_id": { "type": "string", "minLength": 1 },
        "thread_id": { "type": "string" }
      },
      "required": ["channel", "conversation_id"],
      "additionalProperties": false
    }
  }
}
