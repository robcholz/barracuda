{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]{1,16}$"
    },
    "run_number": { "type": "integer", "minimum": 1 }
  },
  "required": ["id", "run_number"],
  "additionalProperties": false
}
