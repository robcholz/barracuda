{
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 16,
      "pattern": "^[A-Za-z0-9_.-]+$"
    },
    "trigger": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": { "const": "once" },
            "at": { "$ref": "#/$defs/utc" }
          },
          "required": ["type", "at"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": { "const": "interval" },
            "at": { "$ref": "#/$defs/utc" },
            "every_seconds": {
              "type": "integer",
              "minimum": 1,
              "maximum": 18446744073709551615
            },
            "count": {
              "type": "integer",
              "minimum": 1,
              "maximum": 4294967295
            }
          },
          "required": ["type", "at", "every_seconds", "count"],
          "additionalProperties": false
        }
      ]
    }
  },
  "required": ["id", "trigger"],
  "additionalProperties": false,
  "$defs": {
    "utc": {
      "type": "string",
      "description": "RFC3339 UTC timestamp matching time.now.utc.",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]\\.[0-9]{3}Z$"
    }
  }
}
