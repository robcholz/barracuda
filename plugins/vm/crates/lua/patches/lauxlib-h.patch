Declarations for what lauxlib.c no longer defines.

Drops luaL_fileresult, luaL_execresult, luaL_loadfilex, luaL_loadfile,
luaL_dofile and luaL_newstate, the io library's file handles, and the stdio
message macros, so nothing here needs <stdio.h>.

--- a/lauxlib.h
+++ b/lauxlib.h
@@ -10,7 +10,6 @@
 
 
 #include <stddef.h>
-#include <stdio.h>
 
 #include "luaconf.h"
 #include "lua.h"
@@ -78,9 +77,6 @@
 LUALIB_API int (luaL_checkoption) (lua_State *L, int arg, const char *def,
                                    const char *const lst[]);
 
-LUALIB_API int (luaL_fileresult) (lua_State *L, int stat, const char *fname);
-LUALIB_API int (luaL_execresult) (lua_State *L, int stat);
