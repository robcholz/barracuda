{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "run_id": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        }
      },
      "required": ["run_id"],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "error": { "enum": ["runtime_unavailable", "busy"] }
      },
      "required": ["error"],
      "additionalProperties": false
    }
  ]
}
